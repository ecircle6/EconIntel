# EconIntel 环境变量示例：复制为 .env 后按需修改；全部可留空（用默认值）
# 注意：GitHub Actions 中请配置仓库 Secrets（名称与下方同名），无需 .env

# ---- 数据库 / 站点路径（默认即可，无需修改）----
# EI_DB_PATH=generator/data/econintel.db
# EI_SITE_DIR=site
# EI_FRONTEND_DIR=frontend

# ---- 时间窗口 ----
# EI_HISTORY_DAYS=90            # 导出窗口（滚动分片，默认 90 天 = 3 块）
# EI_FETCH_DAYS_FIRST=90        # 首跑回填窗口
# EI_FETCH_DAYS_INCREMENTAL=3   # 每日增量抓取窗口

# ---- AI 精简（可选：不配置则自动使用规则算法降级）----
# 支持任何 OpenAI 兼容接口：DeepSeek / OpenAI / 本地 Ollama 等
# EI_LLM_API_KEY=sk-xxxxxxxx
# EI_LLM_BASE_URL=https://api.deepseek.com/v1
# EI_LLM_MODEL=deepseek-chat

# ---- 富化并发与超时（默认值即可）----
# EI_ENRICH_WORKERS=8           # 富化总并发
# EI_OPENALEX_MAILTO=你的邮箱     # 强烈建议填写：OpenAlex 会为带 mailto 的请求预留专属额度（10rps）
# EI_OPENALEX_MIN_INTERVAL=0.25 # OpenAlex 限速（秒/请求）
# EI_S2_MIN_INTERVAL=1.2        # Semantic Scholar 未认证限速间隔（秒）
# EI_PAPER_BUDGET=20            # 单篇富化总预算（秒）
# EI_REQUEST_TIMEOUT=8          # 单请求超时（秒）

# ---- 重要性评分权重（合计 100）----
# EI_W_INSTITUTION=25
# EI_W_CITATIONS=45
# EI_W_RECENCY=24
# EI_W_TYPE=6

# ---- 代理（如需要）----
# PROXY_URL=http://127.0.0.1:7890
